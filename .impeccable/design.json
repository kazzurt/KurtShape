    },
    {
      "name": "Active Reference Picker",
      "kind": "custom",
      "refersTo": "reference-picker-active",
      "description": "Blue receiving field with compact references, full-name labels and explicit removal; Clear all belongs to Reference options.",
      "html": "<section class=\"ds-reference-picker\" aria-label=\"Edges references\"><div class=\"ds-ref-heading\"><button class=\"ds-ref-prompt\" aria-pressed=\"true\" aria-label=\"Select edges; 1 selected\">Select edges</button><button class=\"ds-ref-remove-selected\" aria-label=\"Remove selected references\"><svg aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\">\r\n<g stroke=\"#51575d\" stroke-width=\"0.95\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 5 L19 19 M19 5 L5 19\" fill=\"none\" stroke-width=\"1.9\"/></g>\r\n</svg></button></div><div class=\"ds-ref-row\"><span class=\"ds-ref-name\" title=\"Part 1 · Edge2\">Part 1 · Edge2</span><button class=\"ds-ref-row-remove\" aria-label=\"Remove Part 1 Edge2\"><svg aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\">\r\n<g stroke=\"#51575d\" stroke-width=\"0.95\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 5 L19 19 M19 5 L5 19\" fill=\"none\" stroke-width=\"1.9\"/></g>\r\n</svg></button></div></section>",
      "css": ".ds-reference-picker{font-family:'Segoe UI';font-size:13px;color:#2d3338;background:#e6f1fa;border:1px solid #185fa5;border-radius:2px;width:280px}.ds-ref-heading{display:flex;gap:2px}.ds-ref-prompt{font-family:'Segoe UI';font-size:13px;flex:1;text-align:left;color:#204f79;background:#e6f1fa;border:1px solid #185fa5;border-radius:2px;padding:4px 8px;min-height:20px;cursor:pointer}.ds-ref-prompt:hover{background:#edf2f6}.ds-ref-prompt:focus-visible{outline:none;border-color:#185fa5}.ds-ref-remove-selected,.ds-ref-row-remove{background:transparent;border:1px solid transparent;border-radius:2px;padding:2px;width:28px;height:28px;cursor:pointer}.ds-ref-remove-selected svg,.ds-ref-row-remove svg{width:16px;height:16px}.ds-ref-remove-selected:hover,.ds-ref-row-remove:hover{background:#edf2f6;border-color:#8a949e}.ds-ref-remove-selected:focus-visible,.ds-ref-row-remove:focus-visible{outline:none;border-color:#185fa5}.ds-ref-remove-selected:active,.ds-ref-row-remove:active{background:#e6f1fa;border-color:#185fa5}.ds-ref-row{display:flex;align-items:center;gap:2px;min-height:28px;padding:0 0 0 6px;background:#ffffff}.ds-ref-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}"
    },
    {
      "name": "Modeless Feature Editor",
      "kind": "custom",
      "refersTo": "feature-editor",
      "description": "Static native editor specimen: title and icon-only acceptance remain above the scrolling form; the copyable verdict remains below it.",
      "html": "<section class=\"ds-feature-editor\" aria-label=\"Fillet editor\"><header class=\"ds-feature-header\"><strong class=\"ds-feature-title\">Fillet</strong><button class=\"ds-feature-accept\" aria-label=\"Confirm Fillet\" disabled><svg aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\">\r\n<g stroke=\"#51575d\" stroke-width=\"0.95\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 12 L9 18 21 5\" fill=\"none\" stroke-width=\"2.1\"/></g>\r\n</svg></button><button class=\"ds-feature-cancel\" aria-label=\"Cancel Fillet\"><svg aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\">\r\n<g stroke=\"#51575d\" stroke-width=\"0.95\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 5 L19 19 M19 5 L5 19\" fill=\"none\" stroke-width=\"1.9\"/></g>\r\n</svg></button></header><div class=\"ds-feature-scroll\"><label class=\"ds-feature-field\">Edges<input value=\"Part 1 · Edge2\" aria-label=\"Edges\"/></label><label class=\"ds-feature-field\">Radius<input value=\"0 mm\" aria-label=\"Radius\"/></label></div><div class=\"ds-feature-verdict\" role=\"status\">Radius must be greater than zero.</div></section>",
      "css": ".ds-feature-editor{font-family:'Segoe UI';font-size:13px;color:#2d3338;background:#ffffff;width:320px;min-width:280px;max-width:440px;border:1px solid #8a949e}.ds-feature-header{display:flex;align-items:center;gap:4px;padding:4px 4px 4px 8px;background:#f5f6f7;border-bottom:1px solid #d6dadf}.ds-feature-title{font-size:14px;font-weight:600;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-feature-accept,.ds-feature-cancel{padding:2px;width:28px;height:28px;background:transparent;border:1px solid transparent;border-radius:2px;cursor:pointer}.ds-feature-accept svg,.ds-feature-cancel svg{width:16px;height:16px}.ds-feature-accept:hover,.ds-feature-cancel:hover{background:#edf2f6;border-color:#8a949e}.ds-feature-accept:focus-visible,.ds-feature-cancel:focus-visible{outline:none;border-color:#185fa5}.ds-feature-accept:disabled{color:#646f78;background:transparent;border-color:transparent;cursor:default}.ds-feature-scroll{max-height:120px;overflow-y:auto;padding:8px;display:grid;gap:6px}.ds-feature-field{display:grid;gap:6px;min-width:0}.ds-feature-field input{font-family:'Segoe UI';font-size:13px;color:#2d3338;background:#ffffff;border:1px solid #8a949e;border-radius:2px;padding:4px 6px;min-height:18px;min-width:0}.ds-feature-field input:focus-visible{outline:none;border-color:#185fa5}.ds-feature-verdict{color:#bd3039;padding:8px;overflow-wrap:break-word;user-select:text}"
    },
    {
      "name": "Active Part Row",
      "kind": "nav",
      "refersTo": "history-active-part",
      "description": "Bold active-part identity at rest; hover, focus and selection remain separate from the target-part emphasis.",
      "html": "<button class=\"ds-active-part-row\" aria-label=\"Part 1, active part for new features\"><svg aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\">\r\n<g stroke=\"#51575d\" stroke-width=\"0.95\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 10.5 L12 7 19 10.5 12 14 Z\" fill=\"#dedfe1\" /><path d=\"M5 10.5 L12 14 12 21 5 17.5 Z\" fill=\"#b8bdc2\" /><path d=\"M12 14 L19 10.5 19 17.5 12 21 Z\" fill=\"#899198\" /><path d=\"M9 8 V4 H15 V8\" fill=\"#dedfe1\" /><path d=\"M12 6 V1 M9 4 L12 1 15 4\" fill=\"none\" /></g>\r\n</svg><span>Part 1</span></button>",
      "css": ".ds-active-part-row{font-family:'Segoe UI';font-size:13px;font-weight:700;color:#2d3338;background:#ffffff;border:1px solid transparent;padding:3px 2px;display:flex;align-items:center;gap:4px;width:250px;text-align:left;cursor:pointer}.ds-active-part-row svg{width:20px;height:20px;flex-shrink:0}.ds-active-part-row:hover{background:#edf2f6}.ds-active-part-row:focus-visible{outline:none;border-color:#185fa5}.ds-active-part-row:active,.ds-active-part-row[aria-current=\"true\"]{color:#204f79;background:#e6f1fa}"
    },
    {
      "name": "Below-symbol Command Label",
      "kind": "custom",
      "refersTo": "toolbar-label",
      "description": "Hover or focus the symbol for the native 350ms label delay; the label takes neither focus nor pointer events.",
      "html": "<div class=\"ds-command-demo\"><button class=\"ds-command-anchor\" aria-label=\"Extrude\" aria-describedby=\"ds-extrude-label\"><svg aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\">\r\n<g stroke=\"#51575d\" stroke-width=\"0.95\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 10.5 L12 7 19 10.5 12 14 Z\" fill=\"#dedfe1\" /><path d=\"M5 10.5 L12 14 12 21 5 17.5 Z\" fill=\"#b8bdc2\" /><path d=\"M12 14 L19 10.5 19 17.5 12 21 Z\" fill=\"#899198\" /><path d=\"M9 8 V4 H15 V8\" fill=\"#dedfe1\" /><path d=\"M12 6 V1 M9 4 L12 1 15 4\" fill=\"none\" /></g>\r\n</svg></button><span class=\"ds-command-label\" id=\"ds-extrude-label\" role=\"tooltip\">Extrude  (Shift+E)</span></div>",
      "css": ".ds-command-demo{font-family:'Segoe UI';font-size:13px;position:relative;display:inline-block;margin:0 70px 42px}.ds-command-anchor{background:transparent;border:1px solid transparent;border-radius:2px;padding:4px;min-width:22px;min-height:22px;cursor:pointer}.ds-command-anchor svg{display:block;width:20px;height:20px;margin:auto}.ds-command-anchor:hover{background:#edf2f6;border-color:#8a949e}.ds-command-anchor:focus-visible{outline:none;border-color:#185fa5}.ds-command-anchor:active{background:#e6f1fa;border-color:#185fa5}.ds-command-label{position:absolute;top:calc(100% + 5px);left:50%;transform:translateX(-50%);color:#ffffff;background:#353a40;border:1px solid #242a30;border-radius:2px;padding:5px 8px;white-space:nowrap;pointer-events:none;visibility:hidden;transition:visibility 0s linear 0s}.ds-command-demo:hover .ds-command-label,.ds-command-demo:focus-within .ds-command-label{visibility:visible;transition-delay:350ms}.ds-command-anchor:active+.ds-command-label{visibility:hidden;transition-delay:0s}"
    }
  ],
  "narrative": {
    "northStar": "The Modeling Desk",
    "overview": "KurtShape follows the user's light desktop Onshape reference: a compact document bar, dense command symbols, left history and parts, and a large white modeling canvas. Shaded grayscale CAD glyphs, pale neutral chrome and readable system type make geometry and parameter entry the focus.\n\nThe system is implemented in native Qt around the FreeCAD viewport. KurtShape aligns its active local FreeCAD appearance profile with FreeCAD Light and owns the application palette and stylesheet together, including native Tasks, menus, popups and floating quantity editors. It preserves local document identity, explicit Save, existing modeling transactions, user part appearances, geometry selection and the established SolidWorks mouse gestures.",
    "keyCharacteristics": [
      "Dense icon-only command rows with names available on hover, focus, menus and search.",
      "Light neutral surfaces with blue selection and active reference fields.",
      "Compact modeless feature editors with fixed acceptance controls and visible preview verdicts.",
      "Resizable history and parts beside the native white canvas."
    ],
    "rules": [
      {
        "name": "The Model Color Rule",
        "body": "Theme the workspace and viewer background without overwriting part appearances, geometry selection or native solver states.",
        "section": "colors"
      },
      {
        "name": "The Icon Row Rule",
        "body": "Persistent top command buttons show symbols only. Preserve descriptive action names for menus, accessibility, search and delayed labels.",
        "section": "typography"
      },
      {
        "name": "The Flat Chrome Rule",
        "body": "Use tonal surfaces, thin boundaries and native floating-window separation. Do not introduce decorative card shadows into the modeling workspace.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the document identity elastic and show its full name on hover.",
      "Do provide original command icons, grayscale native fallback, accessible names and real menu/search routes.",
      "Do show a small white-text label below the symbol after the established hover or keyboard-focus delay.",
      "Do keep the receiving reference field blue while preserving independent quantity-entry focus.",
      "Do keep Confirm, Cancel and the current preview verdict outside the scrolling form.",
      "Do use the adjustable history/parts split and bold active-part text without changing selection or camera.",
      "Do keep local Unsaved/Modified wording, explicit Save and copyable errors tied to the current edit.",
      "Do keep native appearance preferences and report text compatible with the owned light palette. Refresh the native report highlighter after changing its parameters so retained warning/error ranges use the new colors and preserve their native severity metadata."
    ],
    "donts": [
      "Don't add inline command captions or category headings to persistent top toolbars.",
      "Don't replace the native viewport, solver, quantity parsing or existing SolidWorks navigation to achieve the appearance.",
      "Don't recolor user parts or alter authoritative geometry for hover, selection or preview styling.",
      "Don't show cloud-save claims or make local document tabs imply cloud element semantics.",
      "Don't let stale completion text appear to be the current preview verdict.",
      "Don't let long form labels or reference names force controls beyond the available screen.",
      "Don't invent unsupported commands, progress percentages or acceptance states.",
      "Don't apply the entire native preference pack to repair appearance; preserve selection, navigation and model colors."
    ]
  }
}
