      "parameters": [
        {"btType": "BTMParameterQuantity-147", "parameterId": "x", "expression": "0.5 in"},
        {"btType": "BTMParameterQuantity-147", "parameterId": "y", "expression": "-0.25 in"},
        {"btType": "BTMParameterQuantity-147", "parameterId": "diameter", "expression": "1 in"}
      ]
    },
    {
      "featureId": "fixture-circle-extrude",
      "name": "Quarter-inch thickness",
